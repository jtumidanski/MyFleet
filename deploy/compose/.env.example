# deploy/compose/.env.example
POSTGRES_USER=myfleet
POSTGRES_PASSWORD=myfleet
POSTGRES_DB=myfleet
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
# Private bucket media-service uses for originals + variants (auto-created on startup).
MEDIA_BUCKET=myfleet-media
# Number of in-process variant-generation worker goroutines.
MEDIA_WORKERS=2
KAFKA_BROKERS=redpanda:9092
# notification-service reaches fleet-service's internal (no-JWT) endpoints at
# this base URL for recipient resolution + the maintenance reminder feed. The
# compose file sets this directly; override here only for non-compose runs.
FLEET_INTERNAL_URL=http://fleet-service:8080
# Google OIDC (fill locally; never commit real values)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost/api/auth/auth/callback
# JWT
JWT_ISSUER=myfleet-auth
JWT_AUDIENCE=myfleet
JWT_KID=kid-1
# RS256 private key in PKCS#1 PEM form (generate locally; never commit real keys).
# e.g. openssl genrsa 2048  — paste as a single line with literal \n, or use an env file loader.
JWT_PRIVATE_KEY_PEM=
# HMAC secret used to sign the short-lived OIDC state/nonce cookie.
OIDC_STATE_SECRET=dev-state-secret-change-me
# SPA origin the browser is redirected back to after login.
APP_BASE_URL=http://localhost
# Secure flag on auth cookies. Local dev serves plaintext HTTP (Traefik :80),
# where browsers drop Secure cookies, so it is false here. Set true in production (HTTPS).
COOKIE_SECURE=false
LOG_LEVEL=info
